<section>
  <div class="section-container">
    <div class="section-content">
        <h1>KING<br>OF<br>KINGS</h1>
        <p>1-3 mai 2026</p>
        <p>Espace Gruyère, Bulle (CH)</p>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "theme" as *;

  section {
    background-image: url("/2026/background2.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    width: 100%;
    height: min(800px, 100vh);
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;

    .section-container {
      min-height: 100%;
      width: 100%;
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;

      position: relative;

      overflow: hidden;

      .section-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 700px;

        h1 {
            font-family: $font-display;
            color: #fff;
            line-height: 100%;
            font-size: 100px;
            font-weight: bold;
        }


        p {
            color: #fff;
            font-family: $font-body;
            font-size: 25px;
            text-transform: uppercase;
            margin: 20px 0;
        }

        .register {

            margin: 40px 0 0 0;

            a {
                color: #fff;
                font-weight: bold;
                font-size: 25px;
                padding: 10px 25px;
                border: none;
                border-radius: 20px;
                background: $color-accent;

                &:hover {
                    background: $color-accent-hover;
                }
            }
        }

        @media screen and (max-width: $mobile-width) {
            h1 {
                font-size: 80px !important;
            }

            p {
                font-size: 20px !important;
            }

            .register a {
                font-size: 20px !important;
            }
        }
      }
    }
  }
</style>
