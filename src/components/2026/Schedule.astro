<style lang="scss">
    @use "../../styles/variables" as *;
    @use "theme" as *;

    section {
        background-color: $color-text-light;
        color: $color-bg;

        width: 100%;
        display: flex;
        justify-content: center;
        padding: 60px 0;

        h2 {
            font-family: $font-display;
            font-size: 45px;
            text-align: center;
        }

        .columns {
            display: flex;
            flex-direction: column;
            font-size: 20px;
            padding: 0 20px;

            .column {
                display: flex;
                flex-direction: column;

                p {
                    margin: 2px 0;

                    span.time {
                        display: inline-block;
                        width: 90px;
                    }

                    span.speaker {
                        display: inline-block;
                        margin: 0 0 5px 20px;
                        font-style: italic;
                        opacity: 0.8;
                    }

                    &.head {
                        margin: 20px 0 10px 0;
                        font-style: italic;
                        font-size: 22px;
                        text-align: center;
                    }


                }

            }
        }
    }

    @media screen and (max-width: $mobile-width) {

        h2 {
            font-size: 35px !important;
        }

        h3 {
            font-size: 25px !important;
        }

        .columns {
            font-size: 12px !important;
        }

    }
</style>
