---
const photos = [
  'benevol_1.jpg',
  'crowd_1.jpg',
  'crowd_2.jpg',
  'crowd_3.jpg',
  'crowd_4.jpg',
  'crowd_5.jpg',
  'crowd_6.jpg',
  'crowd_7.jpg',
  'crowd_8.jpg',
  'hands_1.jpg',
  'scene_1.jpg',
  'scene_2.jpg',
  'scene_3.jpg',
  'scene_4.jpg',
  'scene_5.jpg',
  'scene_6.jpg',
  'technic_1.jpg',
  'technic_2.jpg',
];

const midpoint = Math.ceil(photos.length / 2);
const firstRow = photos.slice(0, midpoint);
const secondRow = photos.slice(midpoint).reverse();
---

<section class="photos">
  <div class="row row-left">
    <div class="row-inner">
      {firstRow.map((photo) => (
        <div class="photo-container">
          <img 
            src={`/2025/photos/${photo}`} 
            alt="" 
            width="200"
            height="200"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
      {firstRow.map((photo) => (
        <div class="photo-container">
          <img 
            src={`/2025/photos/${photo}`} 
            alt="" 
            width="200"
            height="200"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>
  <div class="row row-right">
    <div class="row-inner">
      {secondRow.map((photo) => (
        <div class="photo-container">
          <img 
            src={`/2025/photos/${photo}`} 
            alt="" 
            width="200"
            height="200"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
      {secondRow.map((photo) => (
        <div class="photo-container">
          <img 
            src={`/2025/photos/${photo}`} 
            alt="" 
            width="200"
            height="200"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  .photos {
    width: 100%;
    margin-top: var(--spacing-xl);
    overflow: hidden;

    .row {
      width: 100%;
      overflow: hidden;

      &:hover .row-inner {
        animation-play-state: paused;
      }
    }

    .row-inner {
      display: flex;
      width: fit-content;
      gap: 0;
      will-change: transform;
    }

    .row-left .row-inner {
      animation: scroll-left 120s linear infinite;
    }

    .row-right .row-inner {
      animation: scroll-right 120s linear infinite;
    }

    .photo-container {
      flex-shrink: 0;
      width: 200px;
      height: 200px;
      overflow: hidden;
      
      @media (max-width: 768px) {
        width: 150px;
        height: 150px;
      }
      
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        filter: grayscale(100%);
        display: block;
      }
    }
  }

  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes scroll-right {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }
</style>

