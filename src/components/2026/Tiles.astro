<section>
  <div class="tile tile-left">
    <div class="background"></div>
    <div class="content-wrapper">
      <h2>RJ26</h2>
      <p>1-3 mai 2026 à Bulle</p>
    </div>
  </div>
  <div class="tile tile-right">
    <div class="background"></div>
    <div class="content-wrapper">
      <h2>RJ LOGIN</h2>
      <p>31 janvier 2026</p>
    </div>
  </div>
</section>

<style lang="scss">
  @import "../../styles/variables.scss";

  section {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 0;
    background: #000;

    .tile {
      position: relative;
      width: 100%;
      overflow: hidden;
      display: flex;
      justify-content: center;
      cursor: pointer;

      &:hover {
        .background {
          transform: translateX(-50%) scale(1.05);
        }
      }

      .content-wrapper {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: var(--content-max-width);
        display: flex;
        flex-direction: column;
        padding: var(--spacing-xl);
      }

      h2 {
        font-size: var(--h2-size);
        font-family: var(--font-title);
        font-weight: 700;
        color: var(--text-color);
        margin: 0;
        text-align: left;
      }

      p {
        font-size: var(--text-size);
        color: var(--primary-dark-color);
        font-weight: 700;
        margin: 0;
        text-align: right;
        align-self: flex-end;
      }

      .background {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        max-width: var(--content-max-width);
        height: 100%;
        min-height: 100%;
        background-size: cover;
        background-position: center center;
        filter: grayscale(100%);
        transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        
        &::before,
        &::after {
          content: "";
          position: absolute;
          top: 0;
          width: 15%;
          height: 100%;
          z-index: 1;
          pointer-events: none;
        }
        
        &::before {
          left: 0;
          background: linear-gradient(90deg, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%);
        }
        
        &::after {
          right: 0;
          background: linear-gradient(270deg, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%);
        }
      }
    }

    .tile-left {
      .background {
        background-image: url("/2026/photos/hands_1.jpg");
      }
    }

    .tile-right {
      .background {
        background-image: url("/2026/photos/crowd_1.jpg");
      }
    }
  }
</style>

