    h2 {
      font-size: var(--h2-size);
      font-family: var(--font-title);
      font-weight: 700;
      color: var(--text-color);
      margin: 0;
    }

    p {
      font-size: var(--text-size);
      color: var(--text-color);
      margin: 0;
      line-height: 1.6;
    }

    button {
      padding: var(--spacing-sm) calc(var(--spacing-sm) * 2);
      font-size: var(--text-size);
      font-family: var(--font-body);
      font-weight: 600;
      color: var(--text-color);
      background: var(--primary-color);
      border: none;
      border-radius: 999px;
