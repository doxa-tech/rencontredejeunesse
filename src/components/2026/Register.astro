<section id="inscription">
    <div class="section-container">
        <h2>INSCRIPTION</h2>
        <div class="prices">
           <div>
                <p>Préloc</p>
                <h3>89 CHF</h3>
                <p>du 31 janvier<br> au 8 février</p>
           </div>
           <div>
                <p>Standard</p>
                <h3>99 CHF</h3>
                <p>du 9 février<br> au 19 avril</p>
           </div>
           <div>
                <p>Last minute</p>
                <h3>119 CHF</h3>
                <p>du 20 avril<br> au 1 mai</p>
           </div>
        </div>
        <div class="register">
            <a href="https://tickets.rencontredejeunesse.ch/orders/rj-2026/events/new">S'INSCRIRE</a>
        </div>
        <div class="info">
            <p>Vendredi / Samedi soir 49 CHF</p>
            <p>Samedi (soir inclus) 69 CHF</p>
            <p>Dimanche matin gratuit / après-midi 25 CHF</p>
            <p>Hébergement disponible sur place pour +20 CHF</p>
            <p><a href="/faq">→ Visite notre <span class="underline">FAQ</span> pour avoir plus d'informations</a></p>
        </div>
    </div>
</section>

<style lang="scss">
@use "../../styles/variables" as *;
@use "theme" as *;

section {
    background-size: cover;
    background-color: $color-bg;

    width: 100%;
    display: flex;
    justify-content: center;

    position: relative;
    height: 200%;
    min-height: fit-content;
    text-align: center;
    padding: 0 0 60px 0;

    h2 {
        font-family: $font-display;
        font-size: 45px;
        color: $color-text-light;
    }

    h3 {
        font-size: 35px;
    }

    div.section-container {

        p {
            margin: 10px 0;

            &:nth-child(5) {
                font-style: italic;
            }
        }

        div.prices {
            display: flex;
            justify-content: center;
            gap: 80px;
            width: 100%;
            font-size: 20px;
            flex-wrap: wrap;
            margin: 40px 0 60px 0;

            @media screen and (max-width: $mobile-width) {
                gap: 40px;
            }
        }

    }

    .register a {
        color: #fff;
        font-weight: bold;
        font-size: 25px;
        padding: 10px 25px;
        border: none;
        border-radius: 20px;
        background: $color-accent;

        &:hover {
            background: $color-accent-hover;
        }
    }

    .info {
        display: flex;
        flex-direction: column;
        font-size: 20px;
        margin: 60px 0 0 0;

        a {
            &:hover {
                color: $color-text-light;
            }

            .underline {
                text-decoration: underline;
            }
        }

        p {
            margin: 0 0 5px 0;
        }
    }

    @media screen and (max-width: $mobile-width) {
        h2 {
            font-size: 35px !important;
        }

        h3 {
            font-size: 25px !important;
        }

        .register a {
            font-size: 20px !important;
        }
    }
}
</style>
